# Frontend environment variables. Copy to .env.local and fill in.

# Where the Next.js proxy (app/api/[...path]) forwards to — the file service.
# Server-side only; the browser never sees it. Defaults to the value below.
BACKEND_URL=http://127.0.0.1:6060

# Base path the browser calls. Defaults to "/api/v1" (same-origin, via the
# proxy above). Only set this to hit the backend directly, bypassing the proxy.
# NEXT_PUBLIC_API_URL=/api/v1

# Supabase (Email OTP sign-in). Both are safe to expose to the browser.
# NEXT_PUBLIC_SUPABASE_URL: your project URL, e.g. https://abcdefgh.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: sb_publishable_... (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

NODE_ENV=development
