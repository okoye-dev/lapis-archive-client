# Frontend Environment Variables

# API Base URL for development
NEXT_PUBLIC_DEV_SERVER_URL=http://localhost:6060/api

# API Base URL for production (Railway)
NEXT_PUBLIC_APP_SERVER_URL=https://your-railway-backend-url.railway.app/api

# Environment
NODE_ENV=development

# Supabase (Email OTP auth + reading your own share history)
# Both are safe to expose to the browser.
# NEXT_PUBLIC_SUPABASE_URL: your project URL, e.g. https://abcdefgh.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: sb_publishable_... (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
