# Frontend environment variables. Copy to .env.local and fill in.

# Where the Next.js proxy (app/api/[...path]) forwards to — the file service.
# Server-side only; the browser never sees it.
BACKEND_URL=http://127.0.0.1:6060

# Base path the browser calls. Defaults to "/api/v1" (same-origin, via the
# proxy above). Only set this to hit the backend directly, bypassing the proxy.
# NEXT_PUBLIC_API_URL=/api/v1

# Absolute site URL, used to build correct OG/Twitter preview image links.
# Defaults to http://localhost:3000; set to your real domain in production.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Supabase (Email OTP sign-in). Both are safe to expose to the browser.
# URL: https://<ref>.supabase.co   KEY: sb_publishable_... (Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
